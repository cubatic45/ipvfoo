{
  "name": "IPvFoo Enhanced",
  "manifest_version": 3,
  "version": "2.36.0",
  "description": "Display actual connection IPs with optional ASN, organization, country and evidence-based CDN detection.",
  "homepage_url": "https://github.com/cubatic45/ipvfoo",
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "background": {
    "scripts": [
      "iputil.js",
      "common.js",
      "enrichment/private_ip.js",
      "enrichment/cdn/headers.js",
      "enrichment/cdn/asn_rules.js",
      "enrichment/cdn/detect.js",
      "enrichment/provider.js",
      "enrichment/providers/default.js",
      "enrichment/providers/custom.js",
      "enrichment/cache.js",
      "enrichment/index.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ipvfoo-enhanced@cubatic45",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "page_action": {
    "default_icon": {
      "16": "icon16_transparent.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "permissions": [
    "contextMenus",
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
